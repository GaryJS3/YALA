@attribute [Authorize]
@inject StoreService StoreService
@inject ImageService ImageService

<PageTitle>@(store?.Name ?? "Store") · YALA</PageTitle>
<nav class="item-breadcrumb" aria-label="Breadcrumb"><a href="/stores">Stores</a><span>/</span><span>@(store?.Name ?? "Store")</span></nav>

@if (loading)
{
    <div class="loading-surface"><span class="spinner"></span> Loading store…</div>
}
else if (store is null)
{
    <section class="empty-state"><div class="empty-illustration">?</div><h1>Store not found</h1><p class="muted-copy">It may have been removed or belong to another household.</p><a class="button button-primary" href="/stores">Back to stores</a></section>
}
else
{
    <section class="item-hero store-hero">
        <div class="item-portrait store-portrait" aria-label="@store.Name logo">
            @if (!string.IsNullOrWhiteSpace(store.ImagePath)) { <img src="/images/@store.ImagePath" alt="" /> } else { <span aria-hidden="true">⌂</span> }
            @if (editing) { <label class="item-photo-action">@(string.IsNullOrWhiteSpace(store.ImagePath) ? "Add logo or photo" : "Change logo or photo")<InputFile accept="image/jpeg,image/png,image/webp" OnChange="UploadStoreImageAsync" /></label> }
        </div>
        <div class="item-hero-copy"><p class="eyebrow">YOUR HOUSEHOLD STORE</p><h1>@store.Name</h1><p>@store.OfferCount item@(store.OfferCount == 1 ? "" : "s") tracked at this store.</p><div class="item-status-line"><span class="item-status @(store.IsActive ? "" : "archived")">@(store.IsActive ? "Active store" : "Paused store")</span></div></div>
        <div class="item-hero-actions">@if (!editing) { <button class="button button-primary" type="button" @onclick="BeginEdit">Edit store <span>✎</span></button> } else { <span class="item-editing-state"><span class="item-editing-dot"></span> Editing</span> }</div>
    </section>

    @if (!string.IsNullOrWhiteSpace(error)) { <p class="notice error" role="alert">@error</p> }
    @if (!string.IsNullOrWhiteSpace(success)) { <p class="notice" role="status">@success</p> }

    @if (editing)
    {
        <section class="item-edit-card content-card">
            <div class="section-heading"><div><p class="eyebrow">STORE DETAILS</p><h2>Make it yours</h2></div></div>
            <div class="form-grid store-edit-grid"><div class="form-field"><label for="store-name">Store name</label><input id="store-name" @bind="editName" @bind:event="oninput" maxlength="80" /></div><label class="store-active-toggle"><input type="checkbox" @bind="editActive" /> Store is active</label></div>
            <div class="item-edit-actions"><button type="button" class="button button-outline" @onclick="CancelEdit">Discard changes</button><button type="button" class="button button-primary" disabled="@saving" @onclick="SaveAsync">@(saving ? "Saving…" : "Save changes") <span>↗</span></button></div>
        </section>
    }

    <section class="content-card offer-panel">
        <div class="section-heading"><div><p class="eyebrow">WHAT YOU FIND HERE</p><h2>Items at this store</h2></div><span class="item-section-count">@offers.Count</span></div>
        @if (store.IsActive)
        {
            <div class="offer-add-form">
                <div class="form-field"><label for="offer-item">Catalog item</label><select id="offer-item" value="@catalogItemId" @onchange="SelectCatalogItemAsync"><option value="">Choose an item</option>@foreach (var item in catalogItems) { <option value="@item.Id">@item.Name</option> }</select></div>
                <div class="form-field"><label for="offer-variant">Exact product (optional)</label><select id="offer-variant" value="@productVariantId" @onchange="SelectVariant"><option value="">Any product</option>@foreach (var variant in productVariants) { <option value="@variant.Id">@variant.Name</option> }</select></div>
                <div class="form-field"><label for="offer-aisle">Aisle / section</label><input id="offer-aisle" @bind="aisle" @bind:event="oninput" placeholder="Pets, aisle 4…" /></div>
                <div class="form-field"><label for="offer-price">Price (optional)</label><input id="offer-price" type="number" min="0" step="0.01" @bind="priceText" @bind:event="oninput" placeholder="0.00" /></div>
                <button type="button" class="button button-primary offer-save" @onclick="AddOfferAsync">Add item <span>+</span></button>
            </div>
        }
        else { <p class="notice">Reactivate this store to add items.</p> }

        @if (offers.Count == 0)
        {
            <p class="muted-copy offer-empty">Nothing tracked here yet. Add a catalog item above; store-specific prices are optional.</p>
        }
        else
        {
            <div class="data-list store-offer-list">
                @foreach (var offer in offers)
                {
                    <div class="data-row"><div class="store-offer-mark">⌖</div><div class="data-row-main"><strong>@offer.ItemName @if (offer.IsPreferred) { <span class="preferred-offer-badge">Preferred</span> }</strong><small>@(offer.ProductName ?? "Any product") · @(offer.Aisle ?? "Aisle not noted") · Avg. @(offer.AveragePrice is decimal average ? average.ToString("C") : "no price yet")</small>@if (offer.PriceHistory.Count > 0) { <details class="price-history"><summary>@offer.PriceHistory.Count price update@(offer.PriceHistory.Count == 1 ? "" : "s")</summary><ul>@foreach (var point in offer.PriceHistory) { <li><span>@point.RecordedAt.ToLocalTime().ToString("MMM d, yyyy")</span><strong>@point.Price.ToString("C")</strong></li> }</ul></details> }</div><span class="offer-last">@(offer.LastPrice is decimal last ? last.ToString("C") : "—")</span><button type="button" class="text-button preferred-offer-action" @onclick="() => SetPreferredOfferAsync(offer)">@(offer.IsPreferred ? "Clear preferred" : "Prefer this store")</button><button type="button" class="text-button remove-offer-action" @onclick="() => RemoveOfferAsync(offer)">Remove</button></div>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private bool loading = true, editing, saving;
    private StoreSummary? store;
    private IReadOnlyList<StoreOfferSummary> offers = [];
    private IReadOnlyList<(Guid Id, string Name)> catalogItems = [];
    private IReadOnlyList<(Guid Id, string Name)> productVariants = [];
    private Guid? catalogItemId, productVariantId;
    private string editName = string.Empty, aisle = string.Empty, priceText = string.Empty;
    private bool editActive;
    private string? error, success;

    protected override async Task OnParametersSetAsync() { loading = true; catalogItems = await StoreService.GetCatalogItemsAsync(); await ReloadAsync(); loading = false; }
    private async Task ReloadAsync() { store = await StoreService.GetStoreAsync(Id); offers = store is null ? [] : await StoreService.GetOffersAsync(Id); }
    private void BeginEdit() { editName = store!.Name; editActive = store.IsActive; editing = true; error = success = null; }
    private void CancelEdit() { editing = false; error = null; }
    private async Task UploadStoreImageAsync(InputFileChangeEventArgs args)
    {
        try { saving = true; await ImageService.SaveStoreImageAsync(Id, args.File); await ReloadAsync(); error = null; success = "Store picture saved."; }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IOException or DbUpdateException) { error = ex.Message; }
        finally { saving = false; }
    }
    private async Task SaveAsync() { try { saving = true; await StoreService.SaveStoreAsync(Id, editName); await StoreService.SetActiveAsync(Id, editActive); await ReloadAsync(); editing = false; error = null; success = "Store changes saved."; } catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or DbUpdateException) { error = ex.Message; } finally { saving = false; } }
    private async Task SetPreferredOfferAsync(StoreOfferSummary offer) => await RunOfferActionAsync(() => StoreService.SetPreferredOfferAsync(offer.Id, !offer.IsPreferred));
    private async Task RemoveOfferAsync(StoreOfferSummary offer) => await RunOfferActionAsync(() => StoreService.RemoveOfferAsync(offer.Id));
    private async Task RunOfferActionAsync(Func<Task> action) { try { await action(); error = success = null; await ReloadAsync(); } catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or DbUpdateException) { error = ex.Message; } }
    private async Task SelectCatalogItemAsync(ChangeEventArgs args) { catalogItemId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null; productVariantId = null; productVariants = catalogItemId is Guid itemId ? await StoreService.GetVariantsAsync(itemId) : []; }
    private void SelectVariant(ChangeEventArgs args) => productVariantId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
    private async Task AddOfferAsync()
    {
        if (catalogItemId is not Guid itemId) { error = "Choose a catalog item first."; return; }
        decimal? price = null;
        if (!string.IsNullOrWhiteSpace(priceText))
        {
            if (!decimal.TryParse(priceText, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsed) || parsed < 0) { error = "Enter a valid price, or leave the price blank."; return; }
            price = parsed;
        }
        await RunOfferActionAsync(() => StoreService.SaveOfferAsync(Id, itemId, aisle, price, productVariantId));
        if (error is null) { catalogItemId = productVariantId = null; productVariants = []; aisle = priceText = string.Empty; }
    }
}

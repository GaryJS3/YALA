@page "/catalog"
@attribute [Authorize]
@inject CatalogService CatalogService
@inject NavigationManager Navigation

<PageTitle>Catalog · YALA</PageTitle>

<section class="page-heading">
    <div><p class="eyebrow">THE HOUSEHOLD PANTRY LIST</p><h1>Catalog</h1><p class="heading-subtitle">Your regulars live here. Open an item to see its full story.</p></div>
    <a class="button button-primary" href="/catalog/item/new">New item <span>+</span></a>
</section>

<section class="content-card">
    <input class="search-field" @bind="search" @bind:event="oninput" @bind:after="LoadAsync" placeholder="Search names, aliases, product details…" aria-label="Search catalog" />
    <div class="catalog-filters">
        <button class="filter-chip @(favoritesOnly ? "selected" : "")" type="button" @onclick="() => favoritesOnly = !favoritesOnly">★ Favorites</button>
        <button class="filter-chip @(showArchived ? "selected" : "")" type="button" @onclick="ToggleArchived">@(showArchived ? "Hide archived" : "Show archived")</button>
        <select class="filter-select" aria-label="Filter by category" value="@categoryFilter" @onchange="e => categoryFilter = e.Value?.ToString() ?? string.Empty"><option value="">All categories</option>@foreach (var category in categories) { <option value="@category.Name">@category.Name</option> }</select>
    </div>
    @if (adHocItems.Count > 0)
    {
        <section class="ad-hoc-catalog-section" aria-labelledby="ad-hoc-heading">
            <div class="section-heading"><div><p class="eyebrow">FROM YOUR LIST</p><h2 id="ad-hoc-heading">Not saved to the catalog</h2></div><span class="item-section-count">@adHocItems.Count</span></div>
            <p class="item-section-intro">These one-off items are only on the current shopping list. Promote one to add categories, exact products, photos, and store availability.</p>
            <div class="ad-hoc-catalog-list">
                @foreach (var item in adHocItems)
                {
                    <div class="ad-hoc-catalog-row">
                        <div><strong>@item.Name</strong><small>@($"{item.Quantity:0.##} qty{(string.IsNullOrWhiteSpace(item.StoreName) ? string.Empty : $" · {item.StoreName}")}")</small></div>
                        <div class="ad-hoc-catalog-actions">
                            @if (pendingDeleteId == item.ShoppingListItemId)
                            {
                                <button type="button" class="text-button" @onclick="CancelDelete">Cancel</button>
                                <button type="button" class="button button-danger" @onclick="() => DeleteAsync(item.ShoppingListItemId)">Delete</button>
                            }
                            else
                            {
                                <button type="button" class="text-button remove-offer-action" @onclick="() => pendingDeleteId = item.ShoppingListItemId">Delete</button>
                                <button type="button" class="button button-outline" @onclick="() => PromoteAsync(item.ShoppingListItemId)">Save to catalog <span>↗</span></button>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }
    @if (!FilteredItems().Any())
    {
        <div class="catalog-empty"><span aria-hidden="true">✳</span><h2>No items here yet.</h2><p>Start with something you buy every week.</p><a class="quiet-link" href="/catalog/item/new">Add the first item ↗</a></div>
    }
    else
    {
        <div class="data-list">
            @foreach (var item in FilteredItems())
            {
                <article class="data-row catalog-row @(item.IsArchived ? "archived-row" : "")" @onclick="() => OpenItem(item.Id)">
                    @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                    {
                        <ImageLightbox Src="@($"/images/{item.ImagePath}")" Alt="@item.Name" TriggerClass="catalog-thumb" Loading="lazy" />
                    }
                    else
                    {
                        <div class="catalog-glyph" aria-hidden="true">@Glyph(item.CategoryName)</div>
                    }
                    <div class="data-row-main">
                        <div class="catalog-name-line"><strong>@item.Name</strong>@if (item.IsFavorite) { <span class="catalog-favorite" aria-label="Favorite">★</span> }</div>
                        <small>@(item.Description ?? item.CategoryName ?? "No details yet") · @(item.StoreCount == 1 ? "1 store" : $"{item.StoreCount} stores")@(item.LastPurchased is DateTimeOffset date ? $" · bought {date.ToLocalTime():MMM d}" : "")</small>
                        @if (item.ExactProducts.Count > 0)
                        {
                            <div class="exact-product-list" aria-label="Exact products">
                                @foreach (var product in item.ExactProducts)
                                {
                                    <span><strong>@product.Name</strong>@if (product.IsPreferred && item.ExactProducts.Count > 1) { <i class="preferred-store-mark">Preferred</i> }@if (!string.IsNullOrWhiteSpace(product.Brand) || !string.IsNullOrWhiteSpace(product.Size)) { <small>@string.Join(" · ", new[] { product.Brand, product.Size }.Where(x => !string.IsNullOrWhiteSpace(x)))</small> }@if (product.StoreNames.Count > 0) { <em>@string.Join(", ", product.StoreNames) }</em> }</span>
                                }
                            </div>
                        }
                        @if (item.StorePrices.Count > 0)
                        {
                            <div class="available-store-list" aria-label="Available stores">
                                <span>Available at</span>
                                @foreach (var store in item.StorePrices)
                                {
                                    <StoreMark Name="@store.StoreName" ImagePath="@store.ImagePath" />
                                }
                            </div>
                        }
                    </div>
                    @if (item.IsArchived) { <span class="badge">Archived</span> }
                    <span class="catalog-row-arrow" aria-hidden="true">→</span>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<CatalogEntry> items = [];
    private IReadOnlyList<AdHocCatalogEntry> adHocItems = [];
    private IReadOnlyList<Category> categories = [];
    private string search = string.Empty;
    private bool favoritesOnly;
    private bool showArchived;
    private string categoryFilter = string.Empty;
    private Guid? pendingDeleteId;

    protected override async Task OnInitializedAsync() { categories = await CatalogService.GetCategoriesAsync(); await LoadAsync(); }
    private async Task LoadAsync()
    {
        items = await CatalogService.GetItemsAsync(search, showArchived);
        adHocItems = await CatalogService.GetAdHocItemsAsync();
    }
    private async Task PromoteAsync(Guid shoppingListItemId)
    {
        var itemId = await CatalogService.PromoteAdHocItemAsync(shoppingListItemId);
        Navigation.NavigateTo($"/catalog/item/{itemId}?edit=true");
    }
    private void CancelDelete() => pendingDeleteId = null;
    private async Task DeleteAsync(Guid shoppingListItemId)
    {
        await CatalogService.DeleteAdHocItemAsync(shoppingListItemId);
        pendingDeleteId = null;
        await LoadAsync();
    }
    private IEnumerable<CatalogEntry> FilteredItems() => items.Where(x => (!favoritesOnly || x.IsFavorite) && (string.IsNullOrEmpty(categoryFilter) || x.CategoryName == categoryFilter));
    private async Task ToggleArchived() { showArchived = !showArchived; await LoadAsync(); }
    private void OpenItem(Guid id) => Navigation.NavigateTo($"/catalog/item/{id}");
    private static string Glyph(string? category) => category?.ToLowerInvariant() switch { "produce" => "✿", "dairy" => "◒", "meat" => "⌁", "frozen" => "❄", "bakery" => "◌", "drinks" => "◍", "pets" => "♧", "household" => "⌂", _ => "✳" };
}

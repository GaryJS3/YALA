@attribute [Authorize]
@inject StoreService StoreService
@inject NavigationManager Navigation

<PageTitle>Stores · YALA</PageTitle>

<section class="page-heading">
    <div><p class="eyebrow">YOUR USUAL STOPS</p><h1>Stores</h1><p class="heading-subtitle">Keep your nearby stores and open one to manage what you find there.</p></div>
</section>

<section class="store-setup content-card">
    <div class="section-heading"><h2>Add a store</h2></div>
    <div class="inline-form">
        <input class="search-field" @bind="storeName" @bind:event="oninput" placeholder="e.g. Aldi, Walmart, the Saturday market" aria-label="Store name" />
        <button class="button button-primary" type="button" @onclick="SaveStoreAsync">Add store <span>↗</span></button>
    </div>
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="notice error" role="alert">@error</p> }
</section>

<div class="section-heading"><h2>Your stores</h2><span class="badge">@stores.Count</span></div>

@if (stores.Count == 0)
{
    <div class="content-card stores-empty"><span>⌂</span><h3>No stores yet</h3><p>Add a store to start keeping track of where your household finds things.</p></div>
}
else
{
    <div class="store-card-grid">
        @foreach (var store in stores)
        {
            <article class="store-card store-list-card @(store.IsActive ? "" : "store-inactive")" @onclick="() => OpenStore(store.Id)">
                <div class="store-card-content">
                    <div class="store-card-logo">@if (!string.IsNullOrWhiteSpace(store.ImagePath)) { <img src="/images/@store.ImagePath" alt="" loading="lazy" /> } else { <span aria-hidden="true">⌂</span> }</div>
                    <div class="store-card-copy"><div class="store-card-head"><h3>@store.Name</h3><span class="status-dot @(store.IsActive ? "" : "off")"></span></div><p>@store.OfferCount item@(store.OfferCount == 1 ? "" : "s") tracked · @(store.IsActive ? "Active" : "Paused")</p></div>
                </div>
                <div class="store-card-actions" @onclick:stopPropagation="true">
                    <a class="quiet-link" href="/stores/@store.Id">Manage store</a><span class="store-order-spacer"></span>
                    <button type="button" class="icon-button store-order-button" aria-label="Move @store.Name up" disabled="@(store.SortOrder == stores.Min(x => x.SortOrder))" @onclick="() => MoveStoreAsync(store.Id, -1)">↑</button>
                    <button type="button" class="icon-button store-order-button" aria-label="Move @store.Name down" disabled="@(store.SortOrder == stores.Max(x => x.SortOrder))" @onclick="() => MoveStoreAsync(store.Id, 1)">↓</button>
                    <span class="catalog-row-arrow" aria-hidden="true">→</span>
                </div>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyList<StoreSummary> stores = [];
    private string storeName = string.Empty;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => stores = await StoreService.GetStoresAsync();
    private void OpenStore(Guid id) => Navigation.NavigateTo($"/stores/{id}");
    private async Task MoveStoreAsync(Guid id, int direction) { await StoreService.MoveStoreAsync(id, direction); await LoadAsync(); }
    private async Task SaveStoreAsync()
    {
        try { await StoreService.SaveStoreAsync(null, storeName); storeName = string.Empty; error = null; await LoadAsync(); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or DbUpdateException) { error = ex.Message; }
    }
}

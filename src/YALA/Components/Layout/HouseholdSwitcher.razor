@inject HouseholdService HouseholdService
@inject IHttpContextAccessor HttpContextAccessor

@if (households.Count > 0)
{
    <form class="household-switcher" action="/households/select" method="post" onchange="this.requestSubmit()">
        <AntiforgeryToken />
        <span class="switcher-caption">CURRENT LIST</span>
        <select aria-label="Current household" name="householdId" value="@currentId">
            @foreach (var household in households)
            {
                <option value="@household.Id">@household.Name</option>
            }
        </select>
        <noscript><button type="submit">Switch</button></noscript>
        <span class="switcher-chevron" aria-hidden="true">⌄</span>
    </form>
}
else
{
    <a class="household-switcher new-household-shortcut" href="/households"><span class="switcher-caption">CURRENT LIST</span><span>Create your first household</span><span class="switcher-chevron">↗</span></a>
}

@code {
    private IReadOnlyList<HouseholdChoice> households = [];
    private string currentId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var raw = HttpContextAccessor.HttpContext?.Request.Cookies[YALA.Api.YalaApiEndpoints.HouseholdCookieName];
        if (Guid.TryParse(raw, out var selectedId)) HouseholdService.SelectHousehold(selectedId);
        households = await HouseholdService.GetHouseholdsAsync();
        var current = await HouseholdService.GetCurrentAsync();
        currentId = current?.HouseholdId.ToString() ?? string.Empty;
    }

}

@inherits LayoutComponentBase

<div class="site-shell">
    <header class="site-header">
        <a class="brand" href="/" aria-label="YALA grocery list">
            <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>YALA</span>
        </a>
        <HouseholdSwitcher />
        <AuthorizeView>
            <Authorized>
                <div class="account-chip">
                    <span class="account-initial">@Initial(context.User.Identity?.Name)</span>
                    <span class="account-name">@context.User.Identity?.Name</span>
                    <form action="/Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="Account/Login" />
                        <button type="submit" class="quiet-button">Log out</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <div class="app-frame">
        <aside class="side-rail">
            <nav class="primary-nav" aria-label="Main navigation">
                <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-icon">☷</span>List</NavLink>
                <NavLink href="/catalog"><span class="nav-icon">▦</span>Catalog</NavLink>
                <NavLink href="/stores"><span class="nav-icon">⌂</span>Stores</NavLink>
                <NavLink href="/households"><span class="nav-icon">⌘</span>Households</NavLink>
                <AuthorizeView Policy="@UserAdministrationService.AdministratorPolicy">
                    <NavLink href="/users"><span class="nav-icon">♙</span>Users</NavLink>
                </AuthorizeView>
            </nav>
            <div class="rail-note" title="YALA @BuildLabel"><span class="rail-note-dot"></span> @BuildLabel</div>
        </aside>
        <main class="main-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">×</button>
</div>

@code {
    private static readonly string BuildLabel = CreateBuildLabel();

    private static string Initial(string? value) => string.IsNullOrWhiteSpace(value) ? "Y" : value[..1].ToUpperInvariant();

    private static string CreateBuildLabel()
    {
        var assembly = typeof(MainLayout).Assembly;
        var version = assembly.GetName().Version?.ToString(3) ?? "unknown";
        var build = assembly.ManifestModule.ModuleVersionId.ToString("N")[..8].ToLowerInvariant();
        var buildTimestamp = assembly.GetCustomAttributes(typeof(System.Reflection.AssemblyMetadataAttribute), inherit: false)
            .OfType<System.Reflection.AssemblyMetadataAttribute>()
            .FirstOrDefault(attribute => attribute.Key == "BuildTimestampUtc")?.Value;
        var buildTime = FormatEasternBuildTime(buildTimestamp);
        return $"v{version} · build {build} · {buildTime}";
    }

    private static string FormatEasternBuildTime(string? value)
    {
        if (!DateTime.TryParse(value, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
                out var utcBuildTime))
        {
            return "unknown build time";
        }

        var easternTimeZone = TimeZoneInfo.FindSystemTimeZoneById("America/New_York");
        var easternBuildTime = TimeZoneInfo.ConvertTimeFromUtc(utcBuildTime, easternTimeZone);
        var abbreviation = easternTimeZone.IsDaylightSavingTime(easternBuildTime) ? "EDT" : "EST";
        return $"{easternBuildTime:yyyy-MM-dd h:mm tt} {abbreviation}";
    }
}

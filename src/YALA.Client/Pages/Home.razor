@page "/"
@attribute [AllowAnonymous]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ApiClient Api
@inject ClientState State
@inject NavigationManager Navigation
@inject OfflineSyncService Sync
@inject OfflineQueue Queue
@inject OfflineSnapshotCache Cache

<PageTitle>Grocery list · YALA</PageTitle>
@if (!string.IsNullOrWhiteSpace(error)) { <p class="notice error" role="alert">@error</p> }

@if (loading)
{
    <div class="loading-surface"><span class="spinner"></span> Opening your list…</div>
}
else if (session is null || !session.IsAuthenticated)
{
    <section class="empty-state welcome-empty"><div class="empty-illustration" aria-hidden="true">✳</div><p class="eyebrow">WELCOME TO YALA</p><h1>Make the next grocery run<br />a little easier.</h1><p class="muted-copy">Sign in to open your household list.</p><a class="button button-primary" href="/Account/Login">Sign in <span aria-hidden="true">↗</span></a></section>
}
else if (session.Households.Current is null)
{
    <section class="empty-state welcome-empty"><div class="empty-illustration" aria-hidden="true">✳</div><p class="eyebrow">WELCOME TO YALA</p><h1>Choose your household.</h1><p class="muted-copy">Create or join a household before adding groceries.</p><a class="button button-primary" href="/households">Open households <span aria-hidden="true">↗</span></a></section>
}
else
{
    var groups = StoreGroups();
    var visibleGroups = FilterStoreGroups(groups);
    @if (legacyChanges)
    {
        <p class="notice" role="status">This browser has changes saved by an older version. Their original household was not recorded, so they cannot be safely synced. Check your list and re-add any missing items, then <button class="text-button" @onclick="DiscardLegacyAsync">dismiss old changes</button>.</p>
    }
    @if (State.IsOffline || pending.Count > 0)
    {
    <div class="connection-banner" role="status">@(State.IsOffline ? "Offline" : "Online") · @pending.Count changes waiting <button class="text-button" @onclick="RetryPendingAsync">Sync now</button></div>
    }
    @foreach (var mutation in pending.Where(x => x.Error is not null))
    {
        <div class="notice error" role="alert">A saved change was rejected: @mutation.Error
            <button class="text-button" @onclick="() => RetryAsync(mutation.OperationId)">Retry</button>
            <button class="text-button" @onclick="() => DiscardAsync(mutation.OperationId)">Discard</button>
        </div>
    }
    <section class="quick-add-panel" aria-label="Quick add an item"><div class="quick-add-title"><span class="plus-disc">+</span><span>Add to the list</span><span class="quick-hint">Type an item, or pick a regular</span></div><div class="quick-entry"><span class="search-mark" aria-hidden="true">⌕</span><input @bind="query" @bind:event="oninput" @bind:after="LoadSuggestionsSafelyAsync" @onkeydown="HandleQuickAddKeyAsync" placeholder="Milk, apples, the good coffee…" aria-label="Search or create a grocery item" autocomplete="off" />@if (!string.IsNullOrWhiteSpace(query)) { <button type="button" class="button button-primary add-query-button" @onclick="QuickAddTypedAsync">Add <span>↵</span></button> }</div>
        @if (suggestions.Count > 0) { <div class="quick-picks"><span class="quick-picks-label">MATCHING ITEMS</span><div class="pick-list">@foreach (var suggestion in suggestions) { <button type="button" class="pick-chip" @onclick="() => AddItemAsync(suggestion.Id)">@if (suggestion.IsFavorite) { <span class="favorite-star">★</span> }@suggestion.Name <span class="pick-plus">+</span></button> }</div></div> }
    </section>
    @if (!string.IsNullOrWhiteSpace(query) && !suggestions.Any(x => string.Equals(x.Name, query.Trim(), StringComparison.OrdinalIgnoreCase))) { <button class="create-from-search" type="button" @onclick="QuickAddTypedAsync">Add <strong>“@query.Trim()”</strong> without saving it to the catalog <span>↗</span></button> }
    <section class="list-board"><div class="list-toolbar"><div class="list-title-group"><h2>On the list</h2><span class="item-total">@ListCountLabel()</span></div><div class="toolbar-actions">@if (view == ListView.Stores && groups.Count > 1) { <label class="store-view-filter"><span>Show</span><select value="@selectedStoreFilter" @onchange="StoreFilterChanged" aria-label="Show one store"><option value="@AllStoresFilter">All stores</option>@foreach (var group in groups) { <option value="@StoreFilterKey(group)">@group.Name (@group.Items.Count)</option> }</select></label> }<div class="view-switch" role="group" aria-label="List view"><button type="button" class="@(view == ListView.Items ? "selected" : "")" @onclick="() => SetView(ListView.Items)">Items</button><button type="button" class="@(view == ListView.Stores ? "selected" : "")" @onclick="() => SetView(ListView.Stores)">Stores</button></div>@if (rows.Any(x => x.IsChecked)) { <button class="text-button clear-button" type="button" @onclick="ClearCheckedAsync">Clear checked <span>@rows.Count(x => x.IsChecked)</span></button> }</div></div>
        @if (rows.Count == 0) { <div class="list-empty"><div class="empty-basket" aria-hidden="true"><span>⌑</span></div><h3>Your list is clear.</h3><p>Add a household regular above. It’ll be here next time, too.</p></div> }
        else if (view == ListView.Items) { <div class="grocery-rows">@foreach (var row in rows.Where(x => !x.IsChecked)) { <GroceryRow @key="row.Id" Item="row" Stores="stores" OnToggle="ToggleAsync" OnQuantity="ChangeQuantityAsync" OnRemove="RemoveAsync" OnAssign="AssignStoreAsync" /> }</div>@if (rows.Any(x => x.IsChecked)) { <div class="checked-section"><div class="checked-heading"><span class="checked-rule"></span><span>IN THE CART</span><span class="checked-rule"></span></div>@foreach (var row in rows.Where(x => x.IsChecked)) { <GroceryRow @key="row.Id" Item="row" Stores="stores" OnToggle="ToggleAsync" OnQuantity="ChangeQuantityAsync" OnRemove="RemoveAsync" OnAssign="AssignStoreAsync" /> }</div> } }
        else { @foreach (var group in visibleGroups) { <div class="store-group"><h3><span class="store-pin">⌖</span>@group.Name <span class="store-group-count">@group.Items.Count</span></h3>@foreach (var entry in group.Items) { <GroceryRow @key="entry.Item.Id" Item="entry.Item" Stores="stores" OnToggle="ToggleAsync" OnQuantity="ChangeQuantityAsync" OnRemove="RemoveAsync" OnAssign="AssignStoreAsync" ShowPrices="true" CurrentStoreId="entry.StoreId" ShowStoreAssignment="true" /> }</div> } }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    [SupplyParameterFromQuery(Name = "store")] public string? StoreQuery { get; set; }
    private SessionSnapshot? session;
    private List<ShoppingListRow> rows = [];
    private List<StoreSummary> stores = [];
    private IReadOnlyList<QuickAddChoice> suggestions = [];
    private string query = "";
    private bool loading = true;
    private bool legacyChanges;
    private string? error;
    private IReadOnlyList<QueuedMutation> pending = [];
    private DotNetObjectReference<Home>? reference;
    private const string AllStoresFilter = "all";
    private string selectedStoreFilter = AllStoresFilter;
    private ListView view = ListView.Items;

    protected override Task OnParametersSetAsync()
    {
        view = string.Equals(ViewQuery, "stores", StringComparison.OrdinalIgnoreCase) ? ListView.Stores : ListView.Items;
        ApplyQueryState();
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            legacyChanges = await Queue.HasLegacyChangesAsync();
            session = await Api.GetSessionAsync();
            if (session is not null) await Cache.SaveSessionAsync(session);
            if (session?.IsAuthenticated == true && session.Households.Current is not null)
            {
                State.SetHousehold(session.Households.Current);
                await Sync.FlushAsync();
                pending = await Sync.GetPendingAsync();
                await LoadAsync();
                await LoadSuggestionsAsync();
            }
        }
        catch (Exception ex) when (OfflineSyncService.IsConnectionFailure(ex))
        {
            session = await Cache.GetSessionAsync();
            if (session?.IsAuthenticated == true && session.Households.Current is not null)
            {
                State.SetUser(session.UserId);
                State.SetHousehold(session.Households.Current);
                var cached = await Cache.GetListAsync();
                if (cached is not null) { rows = cached.Rows; stores = cached.Stores; }
            }
            State.SetConnectivity(true, (await Sync.GetPendingAsync()).Count);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { pending = await Sync.GetPendingAsync(); loading = false; }
    }

    private async Task LoadAsync()
    {
        var snapshot = await Api.GetListAsync();
        rows = snapshot.Rows;
        stores = snapshot.Stores;
        ApplyQueryState();
        await Cache.SaveListAsync(snapshot);
        State.SetConnectivity(false, (await Sync.GetPendingAsync()).Count);
    }

    private async Task LoadSuggestionsAsync() => suggestions = await Api.GetSuggestionsAsync(query);
    private async Task AddItemAsync(Guid id)
    {
        if (!await RunQueueableAsync("api/list/add", new ListItemCommand(id), () => Api.AddItemAsync(id))) return;
        query = "";
        await TryLoadAsync();
        await LoadSuggestionsSafelyAsync();
    }

    private async Task QuickAddTypedAsync()
    {
        var name = query.Trim();
        if (name.Length == 0) return;
        if (!await RunQueueableAsync("api/list/quick-add", new QuickAddCommand(name), () => Api.QuickAddAsync(name))) return;
        query = "";
        await TryLoadAsync();
        await LoadSuggestionsSafelyAsync();
    }
    private async Task HandleQuickAddKeyAsync(KeyboardEventArgs args) { if (args.Key == "Enter") await QuickAddTypedAsync(); }
    private async Task ToggleAsync(Guid id) { await RunQueueableAsync("api/list/toggle", new ListRowCommand(id), () => Api.ToggleAsync(id)); await TryLoadAsync(); }
    private async Task ChangeQuantityAsync((Guid Id, decimal Delta) change) { await RunQueueableAsync("api/list/quantity", new QuantityCommand(change.Id, change.Delta), () => Api.ChangeQuantityAsync(change.Id, change.Delta)); await TryLoadAsync(); }
    private async Task RemoveAsync(Guid id) { if (await RunQueueableAsync("api/list/remove", new ListRowCommand(id), () => Api.RemoveAsync(id))) rows.RemoveAll(x => x.Id == id); await TryLoadAsync(); }
    private async Task AssignStoreAsync((Guid Id, Guid? StoreId) value) { await RunQueueableAsync("api/list/assign-store", new AssignStoreCommand(value.Id, value.StoreId), () => Api.AssignStoreAsync(value.Id, value.StoreId)); await TryLoadAsync(); }
    private async Task ClearCheckedAsync() { await RunQueueableAsync("api/list/clear-checked", null, () => Api.ClearCheckedAsync()); await TryLoadAsync(); await LoadSuggestionsSafelyAsync(); }

    private async Task TryLoadAsync()
    {
        try { await LoadAsync(); }
        catch (Exception ex) when (OfflineSyncService.IsConnectionFailure(ex)) { State.SetConnectivity(true, (await Sync.GetPendingAsync()).Count); }
        catch (Exception ex) { error = ex.Message; }
        pending = await Sync.GetPendingAsync();
    }

    private async Task LoadSuggestionsSafelyAsync()
    {
        try { await LoadSuggestionsAsync(); }
        catch (Exception ex) when (OfflineSyncService.IsConnectionFailure(ex)) { suggestions = []; }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task<bool> RunQueueableAsync(string uri, object? body, Func<Task> send)
    {
        error = null;
        try { await Sync.ExecuteAsync(uri, body, send); }
        catch (Exception ex) { error = ex.Message; return false; }
        pending = await Sync.GetPendingAsync();
        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("yalaConnectivity.watch", reference);
    }

    [JSInvokable]
    public async Task Reconnected() { await RetryPendingAsync(); await InvokeAsync(StateHasChanged); }
    private async Task RetryPendingAsync()
    {
        try { await Sync.FlushAsync(); await TryLoadAsync(); }
        catch (Exception ex) { error = ex.Message; }
        pending = await Sync.GetPendingAsync();
    }
    private async Task RetryAsync(Guid id) { await Sync.RetryAsync(id); await TryLoadAsync(); }
    private async Task DiscardAsync(Guid id) { await Sync.DiscardAsync(id); pending = await Sync.GetPendingAsync(); }
    private async Task DiscardLegacyAsync() { await Queue.DiscardLegacyAsync(); legacyChanges = false; }
    private string ListCountLabel() => rows.Any(x => x.IsChecked) ? $"{rows.Count(x => !x.IsChecked)}/{rows.Count} items remain" : $"{rows.Count} item{(rows.Count == 1 ? "" : "s")}";
    private IReadOnlyList<StoreListGroup> StoreGroups() => ShoppingListGrouping.GroupRowsByStore(rows);
    private IReadOnlyList<StoreListGroup> FilterStoreGroups(IReadOnlyList<StoreListGroup> groups) => selectedStoreFilter == AllStoresFilter ? groups : groups.Where(group => StoreFilterKey(group) == selectedStoreFilter).ToArray();
    private void ApplyQueryState()
    {
        selectedStoreFilter = AllStoresFilter;
        if (view != ListView.Stores || string.IsNullOrWhiteSpace(StoreQuery)) return;
        var matchingGroup = StoreGroups().FirstOrDefault(group => string.Equals(group.Name, StoreQuery, StringComparison.OrdinalIgnoreCase) || string.Equals(StoreFilterKey(group), StoreQuery, StringComparison.OrdinalIgnoreCase));
        if (matchingGroup is not null) selectedStoreFilter = StoreFilterKey(matchingGroup);
    }
    private void SetView(ListView next)
    {
        view = next;
        if (view == ListView.Items) selectedStoreFilter = AllStoresFilter;
        UpdateViewUrl();
    }
    private void StoreFilterChanged(ChangeEventArgs args) { selectedStoreFilter = args.Value?.ToString() ?? AllStoresFilter; UpdateViewUrl(); }
    private void UpdateViewUrl()
    {
        var selectedGroup = StoreGroups().FirstOrDefault(group => StoreFilterKey(group) == selectedStoreFilter);
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["view"] = view == ListView.Stores ? "stores" : null,
            ["store"] = view == ListView.Stores && selectedStoreFilter != AllStoresFilter ? selectedGroup?.Name : null
        });
        Navigation.NavigateTo(uri, replace: true);
    }
    private static string StoreFilterKey(StoreListGroup group) => group.StoreId?.ToString() ?? "any";
    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("yalaConnectivity.unwatch"); }
        catch (JSException) { }
        reference?.Dispose();
    }
    private enum ListView { Items, Stores }
}

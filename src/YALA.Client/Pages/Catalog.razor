@page "/catalog"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Catalog · YALA</PageTitle>
<section class="page-heading"><div><p class="eyebrow">THE HOUSEHOLD PANTRY LIST</p><h1>Catalog</h1><p class="heading-subtitle">Your regulars live here. Open an item to see its full story.</p></div><a class="button button-primary" href="/catalog/item/new">New item <span>+</span></a></section>
<section class="content-card">
    @if (error is not null) { <p class="notice error" role="alert">@error <button class="text-button" @onclick="LoadAsync">Reload catalog</button></p> }
    <input class="search-field" @bind="search" @bind:event="oninput" @bind:after="LoadAsync" placeholder="Search names, aliases, product details…" aria-label="Search catalog" />
    <div class="catalog-filters"><button class="filter-chip @(favoritesOnly ? "selected" : "")" @onclick="ToggleFavorites">★ Favorites</button><button class="filter-chip @(showArchived ? "selected" : "")" @onclick="ToggleArchived">@(showArchived ? "Hide archived" : "Show archived")</button><select class="filter-select" value="@categoryFilter" @onchange="CategoryChanged"><option value="">All categories</option>@foreach (var category in categories) { <option value="@category.Name">@category.Name</option> }</select></div>
    @if (adHocItems.Count > 0) { <section class="ad-hoc-catalog-section"><div class="section-heading"><div><p class="eyebrow">FROM YOUR LIST</p><h2>Not saved to the catalog</h2></div><span class="item-section-count">@adHocItems.Count</span></div><div class="ad-hoc-catalog-list">@foreach (var item in adHocItems) { <div class="ad-hoc-catalog-row"><div><strong>@item.Name</strong><small>@item.Quantity qty@(string.IsNullOrWhiteSpace(item.StoreName) ? "" : $" · {item.StoreName}")</small></div><div class="ad-hoc-catalog-actions"><button type="button" class="button button-outline" @onclick="() => PromoteAsync(item.ShoppingListItemId)">Save to catalog <span>↗</span></button></div></div> }</div></section> }
    @if (loading) { <p role="status">Loading catalog…</p> }
    else if (!FilteredItems().Any() && error is null) { <div class="catalog-empty"><span aria-hidden="true">✳</span><h2>No items found.</h2><p>@(search.Length > 0 || favoritesOnly || categoryFilter.Length > 0 ? "Try a different search or filter." : "Start with something you buy every week.")</p></div> }
    else { <div class="data-list">@foreach (var item in FilteredItems()) { <article @key="item.Id" class="data-row catalog-row @(item.IsArchived ? "archived-row" : "")">@if (!string.IsNullOrWhiteSpace(item.ImagePath)) { <ImageLightbox Src="@($"/images/{item.ImagePath}")" Alt="@item.Name" TriggerClass="catalog-thumb" Loading="lazy" /> } else { <div class="catalog-glyph">✳</div> }<div class="data-row-main"><div class="catalog-name-line"><a class="catalog-item-link" href="/catalog/item/@item.Id"><strong>@item.Name</strong></a>@if (item.IsFavorite) { <span class="catalog-favorite">★</span> }</div><small>@(item.Description ?? item.CategoryName ?? "No details yet") · @(item.StoreCount == 1 ? "1 store" : $"{item.StoreCount} stores")</small></div>@if (item.IsArchived) { <span class="badge">Archived</span> }<span class="catalog-row-arrow" aria-hidden="true">→</span></article> }</div> }
</section>

@code {
    private List<CatalogEntry> items = [];
    private List<AdHocCatalogEntry> adHocItems = [];
    private List<CategoryChoice> categories = [];
    private string search = "", categoryFilter = "";
    private bool favoritesOnly, showArchived, loading = true, promoting;
    private long loadVersion;
    private string? error;
    protected override async Task OnInitializedAsync() { await LoadAsync(); }
    private async Task LoadAsync()
    {
        var version = ++loadVersion;
        error = null;
        try
        {
            var snapshot = await Api.GetCatalogAsync(search, showArchived);
            if (version != loadVersion) return;
            items = snapshot.Items;
            adHocItems = snapshot.AdHocItems;
            categories = snapshot.Categories;
        }
        catch (Exception ex) { if (version == loadVersion) error = ex.Message; }
        finally { if (version == loadVersion) loading = false; }
    }
    private IEnumerable<CatalogEntry> FilteredItems() => items.Where(x => (!favoritesOnly || x.IsFavorite) && (string.IsNullOrEmpty(categoryFilter) || x.CategoryName == categoryFilter));
    private void ToggleFavorites() => favoritesOnly = !favoritesOnly;
    private async Task ToggleArchived() { showArchived = !showArchived; await LoadAsync(); }
    private void CategoryChanged(ChangeEventArgs args) => categoryFilter = args.Value?.ToString() ?? string.Empty;
    private async Task PromoteAsync(Guid id)
    {
        if (promoting) return;
        promoting = true;
        error = null;
        try
        {
            if (await Api.SendPromotionAsync(id) is Guid promoted) Navigation.NavigateTo($"/catalog/item/{promoted}?edit=true");
        }
        catch (Exception ex) { error = ex.Message; }
        finally { promoting = false; }
    }
}

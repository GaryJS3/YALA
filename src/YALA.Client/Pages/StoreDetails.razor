@page "/stores/{Id:guid}"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(details?.Store.Name ?? "Store") · YALA</PageTitle>
@if (details is null) { <div class="loading-surface"><span class="spinner"></span> Loading store…</div> }
else { <nav class="item-breadcrumb"><a href="/stores">Stores</a><span>/</span><span>@details.Store.Name</span></nav><section class="page-heading"><div><p class="eyebrow">STORE</p><h1>@details.Store.Name</h1><p class="heading-subtitle">@details.Offers.Count active offers</p></div><button class="button button-outline" @onclick="ToggleActiveAsync">@(details.Store.IsActive ? "Deactivate" : "Activate") store</button></section><section class="content-card"><div class="section-heading"><div><p class="eyebrow">OFFERS</p><h2>Items carried here</h2></div></div>@if (details.Offers.Count == 0) { <p class="detail-empty">No offers yet.</p> } else { <div class="data-list">@foreach (var offer in details.Offers) { <article class="data-row" @key="offer.Id"><div class="data-row-main"><strong>@offer.ItemName</strong><small>@(offer.ProductName ?? "Generic") · @(offer.Aisle ?? "No aisle") · @(offer.LastPrice is decimal p ? p.ToString("C") : "No price")</small></div><button class="text-button" @onclick="() => RemoveOfferAsync(offer.Id)">Remove</button></article> }</div>}</section> }

@code {
    [Parameter] public Guid Id { get; set; }
    private YALA.Client.Models.StoreDetails? details;
    protected override async Task OnParametersSetAsync() => details = await Api.GetStoreDetailsAsync(Id);
    private async Task ToggleActiveAsync() { if (details is not null) { await Api.SetStoreActiveAsync(Id, !details.Store.IsActive); details = await Api.GetStoreDetailsAsync(Id); } }
    private async Task RemoveOfferAsync(Guid id) { await Api.RemoveOfferAsync(id); details = await Api.GetStoreDetailsAsync(Id); }
}

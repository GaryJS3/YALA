@page "/catalog/item/new"
@page "/catalog/item/{Id:guid}"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(details?.Name ?? (Id is null ? "New item" : "Item")) · YALA</PageTitle>
<nav class="item-breadcrumb" aria-label="Breadcrumb"><a href="/catalog">Catalog</a><span>/</span><span>@(details?.Name ?? "New item")</span></nav>
@if (loading) { <div class="loading-surface"><span class="spinner"></span> Loading item…</div> }
else if (Id is not null && details is null) { <section class="empty-state"><h1>Item not found</h1><a class="button button-primary" href="/catalog">Back to catalog</a></section> }
else { <section class="item-hero"><div class="item-hero-copy"><p class="eyebrow">@(Id is null ? "A NEW HOUSEHOLD REGULAR" : details!.CategoryName?.ToUpperInvariant() ?? "UNCATEGORIZED")</p><h1>@(Id is null ? "New item" : details!.Name)</h1><p>@(details?.Description ?? "Add a regular to your catalog.")</p></div></section><section class="content-card item-edit-card"><div class="form-grid"><div class="form-field"><label for="item-name">Friendly name</label><input id="item-name" @bind="name" /></div><div class="form-field"><label for="item-description">Description</label><input id="item-description" @bind="description" /></div><div class="form-field"><label for="item-quantity">Default quantity</label><input id="item-quantity" type="number" min="0.25" step="0.25" @bind="quantity" /></div></div>@if (details is not null) { <div class="item-toggle-row"><label><input type="checkbox" @bind="favorite" /> ★ Favorite</label><label><input type="checkbox" @bind="archived" /> Archive</label><label class="item-photo-action">Item photo <InputFile accept="image/jpeg,image/png,image/webp" OnChange="UploadImageAsync" /></label></div> }<div class="item-edit-actions"><button class="button button-primary" disabled="@saving" @onclick="SaveAsync">@(saving ? "Saving…" : "Save changes") <span>↗</span></button></div>@if (!string.IsNullOrWhiteSpace(message)) { <p class="notice" role="status">@message</p> }</section>
    @if (details is not null) { <section class="content-card item-section"><div class="section-heading"><div><p class="eyebrow">SEARCH SHORTCUTS</p><h2>Aliases</h2></div></div><div class="alias-chips">@foreach (var itemAlias in details.Aliases) { <span class="alias-chip">@itemAlias.Alias <button type="button" @onclick="() => RemoveAliasAsync(itemAlias.Id)">×</button></span> }</div><div class="detail-inline-form"><input @bind="alias" placeholder="Add an alias" /><button class="button button-outline" @onclick="AddAliasAsync">Add <span>+</span></button></div></section><section class="content-card item-section item-products"><div class="section-heading"><div><p class="eyebrow">BRANDS, SIZES & BARCODES</p><h2>Exact products</h2></div><span class="item-section-count">@details.Variants.Count</span></div>@foreach (var variant in details.Variants) { <article class="product-card"><strong>@variant.Name</strong>@if (!string.IsNullOrWhiteSpace(variant.Brand) || !string.IsNullOrWhiteSpace(variant.Size)) { <small>@variant.Brand @variant.Size</small> }<div class="barcode-list">@foreach (var barcode in variant.Barcodes) { <span class="barcode-chip">@barcode.Barcode</span> }</div><button class="text-button" @onclick="() => RemoveVariantAsync(variant.Id)">Remove product</button></article> }<div class="variant-entry"><h3>Add an exact product</h3><div class="form-grid"><div class="form-field"><label>Product name</label><input @bind="variantName" /></div><div class="form-field"><label>Brand</label><input @bind="variantBrand" /></div><div class="form-field"><label>Size</label><input @bind="variantSize" /></div><div class="form-field"><label>Barcode</label><input @bind="variantBarcode" inputmode="numeric" /></div></div><div class="detail-inline-form"><button class="button button-outline" @onclick="LookupAsync" disabled="@lookingUp">@(lookingUp ? "Looking up…" : "Look up barcode")</button><button class="button button-primary" @onclick="AddVariantAsync">Add product <span>+</span></button></div>@if (lookup is not null) { <p class="notice" role="status">Found: @(lookup.Name ?? "Product")@(string.IsNullOrWhiteSpace(lookup.Brand) ? "" : $" · {lookup.Brand}")</p> }</div></section> }
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private CatalogDetails? details;
    private string name = "", description = "", alias = "", message = "";
    private decimal quantity = 1;
    private bool favorite, archived, loading = true, saving, lookingUp;
    private string variantName = "", variantBrand = "", variantSize = "", variantBarcode = "";
    private ProductLookupResult? lookup;
    protected override async Task OnParametersSetAsync() { details = await Api.GetCatalogDetailsAsync(Id); if (details is not null) { name = details.Name; description = details.Description ?? ""; quantity = details.DefaultQuantity; favorite = details.IsFavorite; archived = details.IsArchived; } loading = false; }
    private async Task SaveAsync() { saving = true; try { var savedId = await Api.SaveCatalogItemAsync(new CatalogSaveRequest { Id = Id, Name = name, Description = description, DefaultQuantity = quantity }); if (savedId is Guid newId && Id is null) Navigation.NavigateTo($"/catalog/item/{newId}"); else if (Id is Guid id) { await Api.SetCatalogFavoriteAsync(id, favorite); await Api.SetCatalogArchivedAsync(id, archived); details = await Api.GetCatalogDetailsAsync(id); message = "Saved."; } } finally { saving = false; } }
    private async Task AddAliasAsync() { if (Id is Guid id && !string.IsNullOrWhiteSpace(alias)) { await Api.AddAliasAsync(id, alias); alias = ""; details = await Api.GetCatalogDetailsAsync(id); } }
    private async Task RemoveAliasAsync(Guid id) { await Api.RemoveAliasAsync(id); details = await Api.GetCatalogDetailsAsync(Id); }
    private async Task UploadImageAsync(InputFileChangeEventArgs args) { if (Id is Guid id && args.File is not null) { await Api.UploadItemImageAsync(id, args.File); details = await Api.GetCatalogDetailsAsync(id); message = "Image saved."; } }
    private async Task LookupAsync() { if (string.IsNullOrWhiteSpace(variantBarcode)) return; lookingUp = true; try { lookup = await Api.LookupProductAsync(variantBarcode); if (lookup is not null) { variantName = lookup.Name ?? variantName; variantBrand = lookup.Brand ?? variantBrand; variantSize = lookup.Size ?? variantSize; } } finally { lookingUp = false; } }
    private async Task AddVariantAsync() { if (Id is Guid id && !string.IsNullOrWhiteSpace(variantName)) { await Api.SaveVariantAsync(new VariantSaveRequest { ItemId = id, Name = variantName, Brand = variantBrand, Size = variantSize, Barcode = variantBarcode }); variantName = variantBrand = variantSize = variantBarcode = ""; details = await Api.GetCatalogDetailsAsync(id); } }
    private async Task RemoveVariantAsync(Guid id) { await Api.RemoveVariantAsync(id); details = await Api.GetCatalogDetailsAsync(Id); }
}

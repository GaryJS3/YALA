@page "/households"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject ApiClient Api
@inject ClientState State
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Households · YALA</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">YOUR LISTS, YOUR PEOPLE</p>
        <h1>Households</h1>
        <p class="heading-subtitle">Each home gets its own catalog, stores, and grocery list.</p>
    </div>
</section>

@if (current is not null)
{
    <section class="household-settings-card content-card">
        <div class="household-card-heading">
            <div class="household-emblem" aria-hidden="true">⌂</div>
            <div><p class="eyebrow">CURRENT HOUSEHOLD</p><h2>@current.Name</h2></div>
            @if (households.FirstOrDefault(x => x.Id == current.Id)?.IsDefault == true) { <span class="default-badge">Your default</span> }
        </div>
        <div class="members-heading"><h3>People with access</h3><span>@members.Count</span></div>
        <div class="member-list">
            @foreach (var member in members)
            {
                <div class="member-row"><span class="member-avatar">@FirstLetter(member.DisplayName)</span><span class="member-name">@member.DisplayName</span><span class="member-username">@member.UserName</span>
                    @if (members.Count > 1)
                    {
                        <button type="button" class="text-button remove-member" @onclick="() => RemoveMemberAsync(member)">Remove</button>
                    }
                </div>
            }
        </div>
        <div class="member-add">
            <div class="form-field"><label for="member-username">Add an existing YALA user</label><select id="member-username" @bind="memberUserName"><option value="">Choose a username</option>@foreach (var username in availableUserNames) { <option value="@username">@username</option> }</select></div>
            <button type="button" class="button button-outline" @onclick="AddMemberAsync" disabled="@(string.IsNullOrWhiteSpace(memberUserName))">Add person <span>+</span></button>
        </div>
    </section>

    <section class="content-card household-preferences">
        <div class="section-heading"><div><p class="eyebrow">HOUSEHOLD SETTINGS</p><h2>Name and categories</h2></div></div>
        <div class="inline-form">
            <div class="form-field"><label for="household-name">Household name</label><input id="household-name" class="search-field" @bind="householdName" @bind:event="oninput" maxlength="80" /></div>
            <button type="button" class="button button-outline" @onclick="RenameHouseholdAsync">Save name</button>
        </div>
        <div class="members-heading"><h3>Categories</h3><span>@categories.Count</span></div>
        <div class="inline-form category-add-form">
            <div class="form-field"><label for="category-name">@(editingCategoryId is null ? "Add a category" : "Rename category")</label><input id="category-name" class="search-field" @bind="categoryName" @bind:event="oninput" maxlength="60" /></div>
            <button type="button" class="button button-outline" @onclick="SaveCategoryAsync">@(editingCategoryId is null ? "Add category" : "Save category")</button>
            @if (editingCategoryId is not null) { <button type="button" class="text-button" @onclick="CancelCategoryEdit">Cancel</button> }
        </div>
        <div class="category-settings-list">
            @foreach (var category in categories)
            {
                <div class="category-settings-row"><span>@category.Name</span><div class="category-settings-actions">
                    <button class="icon-button" type="button" aria-label="Move @category.Name up" disabled="@(category.SortOrder == categories.Min(x => x.SortOrder))" @onclick="() => MoveCategoryAsync(category.Id, -1)">↑</button>
                    <button class="icon-button" type="button" aria-label="Move @category.Name down" disabled="@(category.SortOrder == categories.Max(x => x.SortOrder))" @onclick="() => MoveCategoryAsync(category.Id, 1)">↓</button>
                    <button class="text-button" type="button" @onclick="() => BeginCategoryEdit(category)">Rename</button>
                    <button class="text-button" type="button" @onclick="() => DeleteCategoryAsync(category)">Remove</button>
                </div></div>
            }
        </div>
        <div class="archive-household-row">
            @if (!confirmArchive)
            {
                <div><strong>Archive this household</strong><p class="muted-copy">Its list and history are kept. You can restore it later.</p></div>
                <button class="button button-outline" type="button" @onclick="() => confirmArchive = true">Archive household</button>
            }
            else
            {
                <div><strong>Archive @current.Name?</strong><p class="muted-copy">Members will lose access until someone restores it.</p></div>
                <div class="category-settings-actions"><button class="text-button" type="button" @onclick="() => confirmArchive = false">Cancel</button><button class="button button-primary" type="button" @onclick="ArchiveHouseholdAsync">Confirm archive</button></div>
            }
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(message)) { <p class="notice">@message</p> }
@if (!string.IsNullOrWhiteSpace(error)) { <p class="notice error">@error</p> }

<div class="section-heading"><h2>Other households</h2></div>
<section class="household-grid">
    @foreach (var option in households.Where(x => x.Id != current?.Id))
    {
        <article class="household-card content-card">
            <div class="household-card-top"><div class="household-emblem small-emblem" aria-hidden="true">⌂</div><div><h3>@option.Name</h3>@if (option.IsDefault) { <span class="default-badge">Your default</span> }</div></div>
            <div class="household-card-actions">
                <button type="button" class="button button-primary" @onclick="() => SwitchAsync(option.Id)">Open list <span>↗</span></button>
                @if (!option.IsDefault) { <button type="button" class="quiet-link" @onclick="() => MakeDefaultAsync(option.Id)">Make default</button> }
            </div>
        </article>
    }
</section>

@if (archivedHouseholds.Count > 0)
{
    <div class="section-heading"><h2>Archived households</h2></div>
    <section class="household-grid">
        @foreach (var archived in archivedHouseholds)
        {
            <article class="household-card content-card">
                <div class="household-card-top"><div class="household-emblem small-emblem" aria-hidden="true">⌂</div><div><h3>@archived.Name</h3><span class="badge">Archived</span></div></div>
                <div class="household-card-actions"><button type="button" class="button button-outline" @onclick="() => RestoreHouseholdAsync(archived.Id)">Restore household <span>↗</span></button></div>
            </article>
        }
    </section>
}

<section class="content-card create-household-panel">
    <p class="eyebrow">A DIFFERENT HOUSE, A DIFFERENT LIST</p>
    <h2>Create a household</h2>
    <p class="muted-copy">New households start fresh. Nothing from your other lists is copied.</p>
    <div class="inline-form"><input class="search-field" @bind="newHouseholdName" @bind:event="oninput" placeholder="e.g. Parents' House" aria-label="New household name" /><button class="button button-outline" type="button" @onclick="CreateHouseholdAsync">Create household <span>+</span></button></div>
</section>

@if (isAdministrator) { <section class="content-card"><a href="/users" class="button button-outline">Manage local accounts ↗</a></section> }

@code {
    private IReadOnlyList<HouseholdChoice> households = [];
    private IReadOnlyList<HouseholdMemberChoice> members = [];
    private IReadOnlyList<string> availableUserNames = [];
    private IReadOnlyList<HouseholdChoice> archivedHouseholds = [];
    private IReadOnlyList<CategoryChoice> categories = [];
    private HouseholdChoice? current;
    private string householdName = string.Empty;
    private string categoryName = string.Empty;
    private Guid? editingCategoryId;
    private bool confirmArchive;
    private string newHouseholdName = string.Empty;
    private string memberUserName = string.Empty;
    private bool isAdministrator;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var session = await Api.GetSessionAsync();
        isAdministrator = session?.IsAdministrator == true;
        var snapshot = session?.Households ?? new();
        households = snapshot.Items;
        current = snapshot.Current;
        State.SetHousehold(current);
        var settings = current is null ? new HouseholdSettings() : await Api.GetHouseholdSettingsAsync();
        members = settings.Members;
        availableUserNames = settings.AvailableUserNames;
        archivedHouseholds = await Api.GetArchivedHouseholdsAsync();
        categories = snapshot.Categories;
        householdName = current?.Name ?? string.Empty;
        if (current is null) { confirmArchive = false; editingCategoryId = null; categoryName = string.Empty; }
    }

    private async Task SwitchAsync(Guid id) { await Api.SwitchHouseholdAsync(id); Navigation.NavigateTo("/households", forceLoad: true); }
    private async Task MakeDefaultAsync(Guid id) { await Api.MakeDefaultHouseholdAsync(id); await LoadAsync(); }

    private async Task RenameHouseholdAsync()
    {
        try { await Api.RenameHouseholdAsync(householdName); error = null; message = "Household name saved."; await LoadAsync(); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ApiException or HttpRequestException) { error = ex.Message; }
    }

    private async Task SaveCategoryAsync()
    {
        try
        {
            await Api.SaveCategoryAsync(editingCategoryId, categoryName);
            categoryName = string.Empty; editingCategoryId = null; error = null; message = "Category saved."; await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ApiException or HttpRequestException) { error = ex.Message; }
    }

    private void BeginCategoryEdit(CategoryChoice category) { editingCategoryId = category.Id; categoryName = category.Name; }
    private void CancelCategoryEdit() { editingCategoryId = null; categoryName = string.Empty; }

    private async Task DeleteCategoryAsync(CategoryChoice category)
    {
        try { await Api.DeleteCategoryAsync(category.Id); error = null; message = $"{category.Name} removed. Items in it are uncategorized."; await LoadAsync(); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ApiException or HttpRequestException) { error = ex.Message; }
    }

    private async Task MoveCategoryAsync(Guid id, int direction)
    {
        await Api.MoveCategoryAsync(id, direction); await LoadAsync();
    }

    private async Task ArchiveHouseholdAsync()
    {
        try { await Api.ArchiveHouseholdAsync(); error = null; message = "Household archived. You can restore it below."; confirmArchive = false; await LoadAsync(); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ApiException or HttpRequestException) { error = ex.Message; }
    }

    private async Task RestoreHouseholdAsync(Guid id)
    {
        try { await Api.RestoreHouseholdAsync(id); error = null; message = "Household restored."; await LoadAsync(); }
        catch (ApiException ex) { error = ex.Message; }
    }

    private async Task CreateHouseholdAsync()
    {
        try
        {
            var id = await Api.CreateHouseholdAsync(newHouseholdName, households.Count == 0);
            if (id is Guid householdId) await Api.SwitchHouseholdAsync(householdId);
            newHouseholdName = string.Empty; error = null; message = "Your new household is ready."; await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ApiException or HttpRequestException) { error = ex.Message; }
    }

    private async Task AddMemberAsync()
    {
        try
        {
            await Api.AddMemberAsync(memberUserName); memberUserName = string.Empty; error = null; message = "Person added to this household."; await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ApiException or HttpRequestException) { error = ex.Message; }
    }

    private async Task RemoveMemberAsync(HouseholdMemberChoice member)
    {
        try
        {
            await Api.RemoveMemberAsync(member.UserId); error = null; message = $"{member.DisplayName} no longer has access to this household."; await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ApiException or HttpRequestException) { error = ex.Message; }
    }

    private static string FirstLetter(string value) => string.IsNullOrWhiteSpace(value) ? "?" : value[..1].ToUpperInvariant();
}

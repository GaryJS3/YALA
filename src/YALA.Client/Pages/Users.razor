@page "/users"
@attribute [Authorize(Policy = "Administrator")]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject ApiClient Api

<PageTitle>User management · YALA</PageTitle>
<section class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>User management</h1><p class="muted-copy">Manage local accounts and household access.</p></div></section>
<section class="content-card"><div class="form-grid"><div class="form-field"><label>Name</label><input @bind="displayName" /></div><div class="form-field"><label>Username</label><input @bind="userName" /></div><div class="form-field"><label>Initial password</label><input type="password" @bind="password" /></div></div><button class="button button-primary" @onclick="CreateAsync">Create user</button>@if (!string.IsNullOrWhiteSpace(message)) { <p class="notice" role="status">@message</p> }</section><section class="content-card"><div class="section-heading"><div><p class="eyebrow">LOCAL ACCOUNTS</p><h2>@users.Count users</h2></div></div>@foreach (var user in users) { <article class="data-row" @key="user.Id"><div class="data-row-main"><strong>@user.DisplayName</strong><small>@@@user.UserName · @(user.IsAdministrator ? "Administrator" : "User") · @(user.Households.Count == 0 ? "No households" : string.Join(" · ", user.Households))</small></div><button class="text-button" @onclick="() => DeleteAsync(user)">Delete</button></article> }</section>

@code {
    private List<ManagedUser> users = [];
    private string displayName = "", userName = "", password = "", message = "";
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => users = (await Api.GetUsersAsync()).ToList();
    private async Task CreateAsync() { await Api.CreateUserAsync(new UserCreateRequest { DisplayName = displayName, UserName = userName, Password = password }); displayName = userName = password = ""; message = "User created."; await LoadAsync(); }
    private async Task DeleteAsync(ManagedUser user) { await Api.DeleteUserAsync(user.Id); message = "User deleted."; await LoadAsync(); }
}

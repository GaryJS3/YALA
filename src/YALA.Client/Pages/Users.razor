@page "/users"
@attribute [Authorize(Policy = "Administrator")]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject ApiClient Api
@inject ClientState State

<PageTitle>User management · YALA</PageTitle>
<section class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>User management</h1><p class="muted-copy">Manage local accounts and household access.</p></div></section>

<section class="content-card">
    <div class="form-grid">
        <div class="form-field"><label for="new-display-name">Name</label><input id="new-display-name" @bind="displayName" @bind:event="oninput" autocomplete="off" /></div>
        <div class="form-field"><label for="new-username">Username</label><input id="new-username" @bind="userName" @bind:event="oninput" autocomplete="off" /></div>
        <div class="form-field"><label for="new-password">Initial password</label><input id="new-password" type="password" @bind="password" @bind:event="oninput" autocomplete="new-password" /></div>
    </div>
    <button type="button" class="button button-primary" disabled="@busy" @onclick="CreateAsync">@(busy ? "Creating…" : "Create user")</button>
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="notice error" role="alert">@error</p> }
    @if (!string.IsNullOrWhiteSpace(message)) { <p class="notice" role="status">@message</p> }
</section>

<section class="content-card">
    <div class="section-heading"><div><p class="eyebrow">LOCAL ACCOUNTS</p><h2>@users.Count users</h2></div></div>
    @if (loading) { <p class="muted-copy">Loading users…</p> }
    else
    {
        @foreach (var user in users)
        {
            <article class="data-row" @key="user.Id">
                <div class="data-row-main"><strong>@user.DisplayName</strong><small>@@@user.UserName · @(user.IsAdministrator ? "Administrator" : "User") · @(user.Households.Count == 0 ? "No households" : string.Join(" · ", user.Households))</small></div>
                <button type="button" class="text-button" disabled="@busy" @onclick="() => DeleteAsync(user)">Delete</button>
            </article>
        }
    }
</section>

@code {
    private List<ManagedUser> users = [];
    private string displayName = "", userName = "", password = "", message = "", error = "";
    private bool loading = true, busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            users = (await Api.GetUsersAsync()).ToList();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally { loading = false; }
    }

    private async Task CreateAsync()
    {
        error = message = "";
        var cleanDisplayName = displayName.Trim();
        var cleanUserName = userName.Trim();
        if (cleanDisplayName.Length is < 1 or > 80) { error = "Names must be between 1 and 80 characters."; return; }
        if (cleanUserName.Length is < 2 or > 40 || cleanUserName.Any(char.IsWhiteSpace)) { error = "Usernames must be between 2 and 40 characters and contain no spaces."; return; }
        if (password.Length < 8) { error = "Passwords must be at least 8 characters."; return; }

        busy = true;
        try
        {
            await Api.CreateUserAsync(new UserCreateRequest
            {
                DisplayName = cleanDisplayName,
                UserName = cleanUserName,
                Password = password,
                HouseholdId = State.CurrentHouseholdId
            });
            displayName = userName = password = "";
            message = "User created.";
            await LoadAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task DeleteAsync(ManagedUser user)
    {
        error = message = "";
        busy = true;
        try { await Api.DeleteUserAsync(user.Id); message = "User deleted."; await LoadAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }
}

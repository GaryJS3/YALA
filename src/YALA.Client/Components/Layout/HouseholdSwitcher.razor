@inject ApiClient Api
@inject ClientState State
@inject NavigationManager Navigation

@if (error is not null) { <span class="notice error" role="alert">@error</span> }

@if (households.Count > 0)
{
    <label class="household-switcher">
        <span class="switcher-caption">CURRENT LIST</span>
        @if (households.Count > 1)
        {
            <select aria-label="Current household" value="@(State.CurrentHouseholdId?.ToString() ?? "")" @onchange="SwitchHouseholdAsync">
                @foreach (var household in households)
                {
                    <option value="@household.Id">@household.Name</option>
                }
            </select>
            <span class="switcher-chevron" aria-hidden="true">⌄</span>
        }
        else
        {
            <span>@households[0].Name</span>
        }
    </label>
}
else if (householdsLoaded)
{
    <a class="household-switcher new-household-shortcut" href="/households">
        <span class="switcher-caption">CURRENT LIST</span>
        <span>Create your first household</span>
        <span class="switcher-chevron" aria-hidden="true">↗</span>
    </a>
}

@code {
    private List<HouseholdChoice> households = [];
    private bool householdsLoaded;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var snapshot = await Api.GetHouseholdsAsync();
            households = snapshot.Items;
            State.SetHousehold(snapshot.Current);
            householdsLoaded = true;
        }
        catch (Exception ex) when (OfflineSyncService.IsConnectionFailure(ex)) { }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SwitchHouseholdAsync(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id))
        {
            try
            {
                await Api.SwitchHouseholdAsync(id);
                State.SetHousehold(households.FirstOrDefault(x => x.Id == id));
                Navigation.NavigateTo("/", forceLoad: true);
            }
            catch (Exception ex) { error = ex.Message; }
        }
    }
}
